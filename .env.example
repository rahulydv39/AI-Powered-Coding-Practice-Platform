# ==============================================================================
# AI Coding Interview Gym - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: Never commit sensitive credentials or production secrets to source control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME="AI Coding Gym API"
APP_VERSION=0.1.0
DEBUG=true

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
# Used by backend database connection module and Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_coding_gym

# SQLAlchemy Database URL
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_coding_gym

# Synchronous Database URL (used for Alembic migrations if needed)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_coding_gym

# Frontend Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Session & Authentication Configuration (Phase 5.2)
SESSION_COOKIE_NAME=gym_session
SESSION_MAX_AGE_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Social OAuth Sign-In (Phase 5.2)
# Register OAuth Apps in provider developer consoles with the Redirect URIs below:

# Google OAuth (PKCE Flow)
# Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# GitHub OAuth
# Authorization callback URL: http://localhost:8000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Apple Sign-In
# Return URL: http://localhost:8000/api/v1/auth/apple/callback
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback

# Optional SMTP Mailer (for password reset emails in production)
# In local development when unconfigured, password reset tokens are logged to dev server console
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@gym.local"

# Multi-Provider AI Assistant Configuration (Phase 3 & Phase 5.1)
# Supported providers: gemini, claude, openai
AI_ASSISTANT_ENABLED=true
AI_DEFAULT_PROVIDER=gemini
AI_RATE_LIMIT_PER_MINUTE=10

# Google Gemini
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15.0

# Anthropic Claude
# Obtain an API key from Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TIMEOUT_SECONDS=15.0

# OpenAI
# Obtain an API key from OpenAI Platform: https://platform.openai.com/
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=15.0
